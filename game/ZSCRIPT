    {
        Tag "Corporate Compliance Memo";
        Inventory.PickupMessage "Corporate memo collected. This will absolutely not help your performance review.";
        Inventory.PickupSound "coh/memo";
        Inventory.MaxAmount 3;
    }

    States
    {
