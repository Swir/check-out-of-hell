version "4.10.0"

class CheckoutShiftDirector : EventHandler
{
    bool bossCleared;
    bool exitPending;
    int exitTic;
    int lastFuseCount;
    int lastMemoCount;
    int lastOvertimeStage;
    int powerPulseUntil;
    String powerPulseText;

    static int GetOvertimeStage()
    {
        int seconds = Level.maptime / 35;

        if (seconds >= 270)
        {
            return 3;
        }
        if (seconds >= 180)
        {
            return 2;
        }
        if (seconds >= 90)
        {
            return 1;
        }
        return 0;
    }

    static int GetNextOvertimeSecond(int stage)
    {
        if (stage == 0)
        {
            return 90;
        }
        if (stage == 1)
        {
            return 180;
        }
        if (stage == 2)
        {
            return 270;
        }
        return -1;
    }

    static String GetOvertimeLabel(int stage)
    {
        if (stage == 1)
        {
            return "STORE UNSTABLE";
        }
        if (stage == 2)
        {
            return "OVERTIME";
        }
        if (stage >= 3)
        {
            return "HELL RUSH";
        }
        return "SHIFT ACTIVE";
    }

    static String GetPressureMeter(int stage)
    {
        if (stage == 1)
        {
            return "PRESSURE [#---]";
        }
        if (stage == 2)
        {
            return "PRESSURE [###-]";
        }
        if (stage >= 3)
        {
            return "PRESSURE [####]";
        }
        return "PRESSURE [----]";
    }

    static String GetObjectiveText(int fuses, bool cleared, bool clockingOut)
    {
        if (clockingOut)
        {
            return "OBJECTIVE  TIMECARD ACCEPTED";
        }
        if (fuses < 3)
        {
            return String.Format("OBJECTIVE  RESTORE BREAKERS  %d/3", fuses);
        }
        if (!cleared)
        {
            return "OBJECTIVE  CLEAR THE SUPERVISOR";
        }
        return "OBJECTIVE  RETURN TO FRONT CHECKOUT";
    }

    static String GetObjectiveHint(int fuses, bool cleared)
    {
        if (fuses < 2)
        {
            return "ROUTE: SEARCH THE SALES FLOOR FOR POWER";
        }
        if (fuses < 3)
        {
            return "ROUTE: STAFF ONLY ACCESS IS NOW POWERED";
        }
        if (!cleared)
        {
            return "ROUTE: MANAGEMENT RESPONSE ACTIVE";
        }
        return "ROUTE: CLOCK OUT AT THE FRONT LANES";
    }

    override void WorldLoaded(WorldEvent e)
    {
        // EventHandler fields are serialized with the save. Do not wipe the restored
        // objective, boss-clear or Overtime presentation state on a savegame load.
        if (e.IsSaveGame)
        {
            return;
        }

        bossCleared = false;
        exitPending = false;
        exitTic = 0;
        lastFuseCount = 0;
        lastMemoCount = 0;
        lastOvertimeStage = 0;
        powerPulseUntil = 0;
        powerPulseText = "";
    }

    override void WorldThingDied(WorldEvent e)
    {
        if (!e.Thing)
        {
            return;
        }

        Name cls = e.Thing.GetClassName();
        if (cls == 'NightManager' || cls == 'RegionalManager')
        {
            bossCleared = true;
            powerPulseUntil = Level.maptime + 35 * 6;
            powerPulseText = "SUPERVISOR DOWN - FINISH THE SHIFT";
        }
    }

    override void WorldTick()
    {
        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }

        int fuses = p.CountInv("CheckoutFuse");
        int memos = p.CountInv("CorporateMemo");

        // Once management is down, mark the shift as cleared. Reinforcement spawners use
        // this invisible token to stop adding fresh threats during the readable clock-out run.
        if (bossCleared && p.CountInv("SupervisorClearanceToken") == 0)
        {
            p.A_GiveInventory("SupervisorClearanceToken", 1);
        }

        if (fuses > lastFuseCount)
        {
            lastFuseCount = fuses;
            powerPulseUntil = Level.maptime + 35 * 3;

            if (fuses == 1)
            {
                powerPulseText = "POWER ROUTE 1/3 - CHECKOUT LIGHTS RESPOND";
            }
            else if (fuses == 2)
            {
                powerPulseText = "POWER ROUTE 2/3 - STAFF SECURITY ONLINE";
            }
            else
            {
                powerPulseText = "FULL POWER - SUPERVISOR ACCESS RESTORED";
            }

            Actor.Spawn("TeleportFog", p.Pos);
        }

        if (memos > lastMemoCount)
        {
            lastMemoCount = memos;
            powerPulseUntil = Level.maptime + 35 * 5;

            if (memos == 1)
            {
                powerPulseText = "MEMO 1/3: BREAKS MAY OCCUR AFTER CLOCK-OUT";
            }
            else if (memos == 2)
            {
                powerPulseText = "MEMO 2/3: PALLET JACKS ARE NOT EMOTIONAL SUPPORT VEHICLES";
            }
            else
            {
                powerPulseText = "MEMO 3/3: REGIONAL MANAGEMENT DENIES THE EXISTENCE OF HELL";
            }
        }

        int overtimeStage = GetOvertimeStage();
        if (overtimeStage > lastOvertimeStage)
        {
            lastOvertimeStage = overtimeStage;
            p.A_StartSound("coh/overtime", CHAN_AUTO);

            if (powerPulseUntil <= Level.maptime)
            {
                powerPulseUntil = Level.maptime + 35 * 3;
                if (overtimeStage == 1)
                {
                    powerPulseText = "PA: STORE CONDITIONS ARE NO LONGER NORMAL";
                }
                else if (overtimeStage == 2)
                {
                    powerPulseText = "PA: OVERTIME AUTHORIZED - KEEP WORKING";
                }
                else
                {
                    powerPulseText = "PA: HELL RUSH - MANAGEMENT ACCEPTS NO REFUNDS";
                }
            }
        }

        if (!exitPending && bossCleared && fuses >= 3 &&
            p.Pos.X >= -140 && p.Pos.X <= 140 && p.Pos.Y <= -350)
        {
            exitPending = true;
            exitTic = Level.maptime + 35;
            powerPulseUntil = Level.maptime + 35;
            powerPulseText = "TIMECARD ACCEPTED - SHIFT COMPLETE";
            p.A_StartSound("coh/clockout", CHAN_ITEM);
        }

        if (exitPending && Level.maptime >= exitTic)
        {
            exitPending = false;
            ExitLevel(0, false);
        }
    }

    override void RenderOverlay(RenderEvent e)
    {
        if (consoleplayer < 0 || !players[consoleplayer].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[consoleplayer].mo);
        if (!p)
        {
            return;
        }

        int elapsedSeconds = Level.maptime / 35;
        int minutes = elapsedSeconds / 60;
        int seconds = elapsedSeconds % 60;
        int stage = GetOvertimeStage();
        int fuses = p.CountInv("CheckoutFuse");
        int memos = p.CountInv("CorporateMemo");
        int labels = p.CountInv("Clip");
        int receipts = p.CountInv("Shell");
        int cans = p.CountInv("RocketAmmo");

        String clockText = String.Format("SHIFT %02d:%02d  //  CLOCK-OUT TARGET 06:00", minutes, seconds);
        String stageText = String.Format("OVERTIME  %s", GetOvertimeLabel(stage));
        String pressureText = GetPressureMeter(stage);
        String powerText = String.Format("POWER  %d/3", fuses);
        String memoText = String.Format("MEMOS  %d/3", memos);
        String taskText = GetObjectiveText(fuses, bossCleared, exitPending);
        String hintText = GetObjectiveHint(fuses, bossCleared);
        String overtimeText = "MAXIMUM OVERTIME";
        String healthText = String.Format("WORKER HP  %03d", p.health);
        String ammoText = String.Format("RESERVES  LABELS %03d  RECEIPTS %02d  CANS %02d", labels, receipts, cans);

        int nextOvertimeSecond = GetNextOvertimeSecond(stage);
        if (nextOvertimeSecond >= 0)
        {
            int remaining = nextOvertimeSecond - elapsedSeconds;
            if (remaining < 0)
            {
                remaining = 0;
            }
            overtimeText = String.Format("NEXT ESCALATION  %02d:%02d", remaining / 60, remaining % 60);
        }

        int stageColor = Font.CR_GREEN;
        if (stage == 1)
        {
            stageColor = Font.CR_YELLOW;
        }
        else if (stage == 2)
        {
            stageColor = Font.CR_ORANGE;
        }
        else if (stage >= 3)
        {
            stageColor = Font.CR_RED;
        }

        int healthColor = Font.CR_GREEN;
        if (p.health <= 50)
        {
            healthColor = Font.CR_YELLOW;
        }
        if (p.health <= 25)
        {
            healthColor = Font.CR_RED;
        }

        // Objective card: one large readable task, one route hint, then optional progress.
        Screen.DrawText(smallfont, Font.CR_GOLD, 12, 10, "CHECKOUT OF HELL // NIGHT SHIFT",
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, Font.CR_WHITE, 12, 22, taskText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, Font.CR_GRAY, 12, 34, hintText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, Font.CR_GOLD, 12, 46, powerText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, memos >= 3 ? Font.CR_GREEN : Font.CR_GRAY, 92, 46, memoText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);

        // Overtime card: readable with text as well as color for accessibility.
        Screen.DrawText(smallfont, Font.CR_WHITE, 398, 10, clockText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, stageColor, 458, 22, stageText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, stageColor, 490, 34, pressureText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, stageColor, 462, 46, overtimeText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);

        // Combat strip keeps critical information at the lower edge without hiding the playfield.
        Screen.DrawText(smallfont, healthColor, 12, 458, healthText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        Screen.DrawText(smallfont, Font.CR_WHITE, 154, 458, ammoText,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);

        if (p.health <= 25)
        {
            Screen.DrawText(smallfont, Font.CR_RED, 12, 446, "WORKER CONDITION: CRITICAL",
                DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        }

        if (powerPulseUntil > Level.maptime && powerPulseText.Len() > 0)
        {
            Screen.DrawText(smallfont, Font.CR_GOLD, 112, 196, powerPulseText,
                DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        }

        if (exitPending)
        {
            Screen.DrawText(smallfont, Font.CR_GOLD, 220, 220, "TIMECARD ACCEPTED - CLOCKING OUT...",
                DTA_VirtualWidth, 640, DTA_VirtualHeight, 480);
        }
    }
}

