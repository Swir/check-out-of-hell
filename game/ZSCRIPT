class CheckoutBossWaveSpawner : Actor
{
    int startTic;
    int nextWave;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        startTic = -1;
        nextWave = 0;
    }

    override void Tick()
    {
        Super.Tick();

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p || p.CountInv("CheckoutFuse") < 3 || p.CountInv("SupervisorClearanceToken") > 0)
        {
            return;
        }

        if (startTic < 0)
        {
            startTic = Level.maptime;
            nextWave = 1;
            Actor.Spawn("TeleportFog", Pos);
            return;
        }

        int elapsed = (Level.maptime - startTic) / 35;

        if (nextWave == 1 && elapsed >= 15)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("AngrySelfCheckout", Pos);
            nextWave = 2;
            return;
        }

        if (nextWave == 2 && elapsed >= 34)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("CartOfDoom", Pos);
            nextWave = 3;
            return;
        }

        if (nextWave == 3 && elapsed >= 54)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("ScannerTurret", Pos);
            nextWave = 4;
            return;
        }

        if (nextWave == 4 && elapsed >= 76)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("PalletJack", Pos);
            nextWave = 5;
        }
    }
}

class CheckoutStaffShutter : Actor
{
    bool opened;

    Default
    {
        Radius 18;
        Height 72;
        +SOLID
        +NOGRAVITY
    }

    States
    {
    Spawn:
        COSH A -1 Bright;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        opened = false;
    }

    override void Tick()
    {
        Super.Tick();

        if (opened || !players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p || p.CountInv("CheckoutFuse") < 2)
        {
            return;
        }

        opened = true;
        p.A_StartSound("coh/shutter", CHAN_AUTO);
        Actor.Spawn("TeleportFog", Pos);
        Destroy();
    }
}

