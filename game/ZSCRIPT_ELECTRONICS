        {
            spawned = true;
            Destroy();
        }
    }
}

// Powered display hardware becomes unstable only after Overtime begins. Every burst has a two-second
// warning, stays on an outer display lane and uses deterministic stage-scaled spacing. The optional
// kill switch or supervisor clearance cancels even an already armed burst without stopping enemies.
class ElectronicsDemoSurgeSpawner : Actor
{
    bool warningArmed;
    int burstTic;
    int nextCheck;
    int nextSurgeTic;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        warningArmed = false;
        burstTic = 0;
        nextCheck = Level.maptime + 7;
        nextSurgeTic = 0;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }
        if (p.CountInv("SupervisorClearanceToken") > 0 || p.CountInv("ElectronicsDisplayKillSwitch") > 0)
        {
            Destroy();
            return;
        }
        if (p.CountInv("CheckoutFuse") < 3)
        {
            return;
        }

        int stage = CheckoutShiftDirector.GetOvertimeStage();
        if (stage <= 0)
        {
            return;
        }

        if (warningArmed)
        {
            if (Level.maptime < burstTic)
            {
                return;
            }

            Actor.Spawn("ElectronicsDisplayBurst", Pos);
            warningArmed = false;

            int delaySeconds = 32;
            if (stage >= 3)
            {
                delaySeconds = 18;
            }
            else if (stage >= 2)
            {
                delaySeconds = 24;
            }
            nextSurgeTic = Level.maptime + 35 * delaySeconds;
            return;
        }

        if (nextSurgeTic == 0)
        {
            nextSurgeTic = Level.maptime + 35 * 16;
            return;
        }
        if (Level.maptime < nextSurgeTic)
        {
            return;
        }

        Actor.Spawn("OvertimeWarningFlash", Pos);
        warningArmed = true;
        burstTic = Level.maptime + 35 * 2;
    }
}
