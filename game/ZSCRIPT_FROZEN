// CHECKOUT OF HELL - Frozen Foods department-local state helpers.

// MAP03 places exactly one initializer near the player start. It clears optional Corporate Memo
// progress carried from a previous department, then destroys itself. Because destroyed map actors
// stay destroyed in savegames, normal save/restore inside Frozen Foods preserves newly found memos.
class FrozenDepartmentInitSpawner : Actor
{
    int nextCheck;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        nextCheck = 0;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }

        p.A_TakeInventory("CorporateMemo", 3);
        Destroy();
    }
}

// Frozen Foods turns the first two cold-chain repairs into readable combat beats instead of
// spawning extra pressure directly on the objective. Each newly restored breaker first flashes a
// three-second warning on the right freezer flank, then calls one themed retail hazard. The final
// power step is a physical compressor reset at the rear rather than a third loose breaker pickup.
class FrozenBreakerResponseSpawner : Actor
{
    int observedFuseCount;
    int pendingFuse;
    int responseTic;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        observedFuseCount = 0;
        pendingFuse = 0;
        responseTic = 0;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }
        if (p.CountInv("SupervisorClearanceToken") > 0)
        {
            Destroy();
            return;
        }

        int fuses = p.CountInv("CheckoutFuse");

        if (pendingFuse > 0)
        {
            if (Level.maptime < responseTic)
            {
                return;
            }

            Actor.Spawn("TeleportFog", Pos);
            if (pendingFuse == 1)
            {
                Actor.Spawn("ScannerTurret", Pos);
            }
            else if (pendingFuse == 2)
            {
                Actor.Spawn("CartOfDoom", Pos);
            }

            observedFuseCount = pendingFuse;
            pendingFuse = 0;

            if (observedFuseCount >= 2 && fuses >= 3)
            {
                Destroy();
            }
            return;
        }

        if (fuses >= 3 && observedFuseCount >= 2)
        {
            Destroy();
            return;
        }

        if (fuses > observedFuseCount && observedFuseCount < 2)
        {
            pendingFuse = observedFuseCount + 1;
            responseTic = Level.maptime + 35 * 3;
            Actor.Spawn("OvertimeWarningFlash", Pos);
        }
    }
}

// After the two freezer breaker circuits are restored, the rear compressor control materializes as
// the department's final useful work task. Picking the project-owned control grants the third power
// token, so the hardened Night Manager/cache/wave gates still use the same authoritative 3/3 state.
class FrozenCompressorResetSpawner : Actor
{
    bool spawned;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        spawned = false;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (spawned || Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }

        int fuses = p.CountInv("CheckoutFuse");
        if (p.CountInv("SupervisorClearanceToken") > 0 || fuses >= 3)
        {
            Destroy();
            return;
        }
        if (fuses < 2)
        {
            return;
        }

        Actor.Spawn("OvertimeWarningFlash", Pos);
        Actor reset = Actor.Spawn("FrozenCompressorReset", Pos);
        if (reset)
        {
            spawned = true;
            Destroy();
        }
    }
}
