// CHECKOUT OF HELL - Management Floor development actors.
// Management Floor presentation is project-owned and generated in-repository. No proprietary Doom,
// Star Wars or other ripped commercial assets are used.

// Hidden hand-off state for the boardroom review. The physical authorization pickup starts a timed
// corporate approval hold; the sequence actor owns the final authoritative CheckoutFuse grant.
actor ManagementBoardroomReviewPending : Inventory
{
    Tag "Boardroom Review Pending"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        TNT1 A -1
        Stop
    }
}

// Physical boardroom work item. It lives behind the existing 2/3-power staff shutters and starts a
// timed approval hold instead of granting the final power token immediately.
actor ManagementBoardroomAuthorization : CustomInventory 17020
{
    Tag "Boardroom Breaker Authorization"
    Inventory.PickupMessage "Boardroom review started. Hold the floor for corporate approval."
    Inventory.PickupSound "coh/fuse"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        ENRB A -1 Bright
        Stop
    Pickup:
        TNT1 A 0 A_GiveInventory("ManagementBoardroomReviewPending", 1)
        Stop
    }
}

// The District Director now has its own project-owned sprite and audio language rather than borrowing
// the Regional Manager silhouette. RegionalManager inheritance keeps proven collision/projectile defaults,
// while every visible state and combat cue below is department-specific and deterministic.
actor DistrictDirector : RegionalManager
{
    Tag "The District Director"
    Health 1400
    Speed 11
    PainChance 28
    SeeSound "coh/directoridle"
    PainSound "coh/directorhit"
    DeathSound "coh/directordown"

    States
    {
    Spawn:
        DDIR A 10 A_Look
        Loop
    See:
        DDIR A 3 A_Chase
        DDIR B 3 A_Chase
        DDIR C 3 A_Chase
        DDIR D 3 A_Chase
        Loop
    Missile:
        DDIR E 0 A_JumpIfHealthLower(700, "MissileRage")
        DDIR E 5 A_FaceTarget
        DDIR F 4 Bright A_PlaySound("coh/directorstamp", CHAN_WEAPON)
        DDIR F 0 Bright A_CustomMissile("ExecutiveStampProjectile", 44, 0, 0)
        DDIR G 4 Bright A_PlaySound("coh/directorattack", CHAN_WEAPON)
        DDIR G 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 42, 0, 16)
        DDIR G 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 42, 0, 0)
        DDIR G 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 42, 0, -16)
        DDIR E 5
        Goto See
    MissileRage:
        DDIR H 4 Bright A_FaceTarget
        DDIR H 0 Bright A_PlaySound("coh/directorphase", CHAN_BODY)
        DDIR I 3 Bright A_CustomMissile("CorporateRedTapeProjectile", 44, 0, -28)
        DDIR I 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 44, 0, -14)
        DDIR I 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 44, 0, 0)
        DDIR I 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 44, 0, 14)
        DDIR I 0 Bright A_CustomMissile("CorporateRedTapeProjectile", 44, 0, 28)
        DDIR J 5 Bright A_PlaySound("coh/directorstamp", CHAN_WEAPON)
        DDIR J 0 Bright A_CustomMissile("ExecutiveStampProjectile", 48, 0, -10)
        DDIR J 0 Bright A_CustomMissile("ExecutiveStampProjectile", 48, 0, 10)
        DDIR H 4
        Goto See
    Pain:
        DDIR K 3
        DDIR K 3 A_Pain
        Goto See
    Death:
        DDIR L 6 A_PlaySound("coh/directordown", CHAN_BODY)
        DDIR M 6
        DDIR N 7 A_NoBlocking
        DDIR O -1
        Stop
    Raise:
        DDIR O 5
        DDIR N 5
        DDIR M 5
        DDIR L 5
        Goto See
    }
}
