// CHECKOUT OF HELL - Overtime environmental hazards
// Project-owned presentation generated by tools/generate_overtime_assets.py.
// The timed hazard anchor itself lives in ZSCRIPT_CLOCKOUT so supervisor clearance can
// retire every anchor before the readable return-to-checkout leg.

actor OvertimeWarningFlash
{
    Radius 2
    Height 2
    +NOBLOCKMAP
    +NOGRAVITY
    +NOCLIP

    States
    {
    Spawn:
        OWRN A 6 Bright A_PlaySound("coh/overtimealarm", CHAN_BODY)
        OWRN A 6 Bright
        OWRN A 6
        Stop
    }
}

actor OvertimeFloorArc
{
    Radius 8
    Height 8
    +NOBLOCKMAP
    +NOGRAVITY
    +NOCLIP

    States
    {
    Spawn:
        OARC A 8 Bright A_PlaySound("coh/overtimealarm", CHAN_BODY)
        OARC B 8 Bright
        OARC C 0 Bright A_PlaySound("coh/overtimearc", CHAN_BODY)
        OARC C 0 Bright A_Explode(10, 72)
        OARC C 4 Bright
        OARC D 5 Bright
        Stop
    }
}
