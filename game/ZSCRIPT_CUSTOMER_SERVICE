// CHECKOUT OF HELL - Customer Service refund authorization objective.
// The sequence is intentionally map-local and save-safe: actor fields serialize with GZDoom saves,
// while the pending inventory token ties the physical terminal interaction to this timed hold.

class CustomerServiceRefundAuthorizationSpawner : Actor
{
    bool spawned;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        spawned = false;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (spawned || Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }

        int fuses = p.CountInv("CheckoutFuse");
        if (p.CountInv("SupervisorClearanceToken") > 0 || fuses >= 3)
        {
            p.A_TakeInventory("CustomerServiceRefundPending", 1);
            Destroy();
            return;
        }
        if (p.CountInv("CustomerServiceRefundPending") > 0)
        {
            Destroy();
            return;
        }
        if (fuses < 2)
        {
            return;
        }

        Actor.Spawn("OvertimeWarningFlash", Pos);
        Actor terminal = Actor.Spawn("CustomerServiceRefundAuthorization", Pos);
        if (terminal)
        {
            spawned = true;
            Destroy();
        }
    }
}

// Corporate takes twelve seconds to authorize the final repair. Enemy responses are deliberately
// telegraphed and enter from one authored outer queue lane so the player can read the pressure while
// defending the desk. The third CheckoutFuse is granted only when the hold completes, which keeps
// the existing supervisor/clock-out gates authoritative instead of adding a parallel completion flag.
class CustomerServiceRefundAuditSequence : Actor
{
    bool active;
    int startTic;
    int stage;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP
        +NOSECTOR
        +NOGRAVITY
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        active = false;
        startTic = 0;
        stage = 0;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }

        if (p.CountInv("SupervisorClearanceToken") > 0 || p.CountInv("CheckoutFuse") >= 3)
        {
            p.A_TakeInventory("CustomerServiceRefundPending", 1);
            Destroy();
            return;
        }

        if (p.CountInv("CustomerServiceRefundPending") <= 0)
        {
            if (active)
            {
                Destroy();
            }
            return;
        }

        if (!active)
        {
            active = true;
            startTic = Level.maptime;
            stage = 0;
            Actor.Spawn("OvertimeWarningFlash", Pos);
            p.A_StartSound("coh/overtime", CHAN_AUTO);
            return;
        }

        int elapsed = Level.maptime - startTic;

        if (stage == 0 && elapsed >= 35 * 2)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("AngrySelfCheckout", Pos);
            stage = 1;
        }

        if (stage == 1 && elapsed >= 35 * 5)
        {
            Actor.Spawn("OvertimeWarningFlash", Pos);
            stage = 2;
        }

        if (stage == 2 && elapsed >= 35 * 7)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("ScannerTurret", Pos);
            stage = 3;
        }

        if (stage == 3 && elapsed >= 35 * 9)
        {
            Actor.Spawn("OvertimeWarningFlash", Pos);
            stage = 4;
        }

        if (stage == 4 && elapsed >= 35 * 10)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("CartOfDoom", Pos);
            stage = 5;
        }

        if (stage == 5 && elapsed >= 35 * 12)
        {
            p.A_GiveInventory("CheckoutFuse", 1);
            p.A_TakeInventory("CustomerServiceRefundPending", 1);
            p.A_StartSound("coh/fuse", CHAN_ITEM);
            Actor.Spawn("TeleportFog", p.Pos);
            Destroy();
        }
    }
}

