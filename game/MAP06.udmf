// Management Floor uses paired executive-office wings around a permanently open central corridor.
vertex { x = -620.0; y = -260.0; }
vertex { x = -180.0; y = -260.0; }
vertex { x =  180.0; y = -260.0; }
vertex { x =  620.0; y = -260.0; }
