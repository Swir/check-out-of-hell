vertex { x = -180.0; y =    0.0; }
vertex { x =  180.0; y =    0.0; }
vertex { x =  620.0; y =    0.0; }
vertex { x = -620.0; y =  260.0; }
vertex { x = -180.0; y =  260.0; }
vertex { x =  180.0; y =  260.0; }
vertex { x =  620.0; y =  260.0; }

// Rear boardroom wall leaves one narrow center doorway. Two powered shutters seal the doorway until
// both executive access circuits are restored, so the final authorization cannot be grabbed early.
vertex { x = -600.0; y = 330.0; }
vertex { x =  -50.0; y = 330.0; }
vertex { x =   50.0; y = 330.0; }
vertex { x =  600.0; y = 330.0; }

