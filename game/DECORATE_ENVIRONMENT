// Optional Warehouse 13.5 cover/resource trade-off. Four piles seal the damaged-goods nook:
// spending ammo to break one opens a useful reward route, while mandatory objectives stay outside.
// BOXE is project-owned art generated by the normal environment asset pipeline.
actor WarehouseStockPile 17136
{
    Tag "Damaged-Goods Stock Pile"
    Health 75
    Radius 26
    Height 48
    +SOLID
    +SHOOTABLE
    +NOBLOOD

    States
    {
    Spawn:
        BOXE A -1
        Stop
    Death:
        BOXE A 3 A_PlaySound("coh/palletdown", CHAN_BODY)
        BOXE A 0 A_NoBlocking
        TNT1 A 1
        Stop
    }
}
