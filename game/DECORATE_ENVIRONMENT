// Slow, readable failing-light cycle. Avoid short 2-tic strobe bursts while retaining the
// abandoned-store atmosphere and a visible contrast change.
actor FailingFluorescent 17127
{
    Radius 4
    Height 18
    +NOBLOCKMAP
    +NOGRAVITY
    States
    {
    Spawn:
        FLIT A 70 Bright
        FLIT B 12
        FLIT C 18 Bright
        FLIT D 12
        Loop
    }
}

