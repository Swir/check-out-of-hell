// CHECKOUT OF HELL - Customer Service department-local objective actors.
// Reuses project-owned console art; no third-party or proprietary game assets are required.

actor CustomerServiceRefundPending : Inventory
{
    Tag "Refund Authorization Pending"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        TNT1 A -1
        Stop
    }
}

// After two desk circuits are restored, the rear Customer Service terminal becomes the final
// non-combat objective. Picking it up starts a timed refund-audit hold instead of granting the
// third power token immediately; the map-local ZScript sequence owns the authoritative hand-off.
actor CustomerServiceRefundAuthorization : CustomInventory
{
    Tag "Refund Authorization Terminal"
    Inventory.PickupMessage "Refund authorization started. Hold the service desk while Corporate verifies your existence."
    Inventory.PickupSound "coh/fuse"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        ENRB A -1 Bright
        Stop
    Pickup:
        TNT1 A 0 A_GiveInventory("CustomerServiceRefundPending", 1)
        Stop
    }
}
