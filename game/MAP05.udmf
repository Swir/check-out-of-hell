thing
{
    x = 0.0; y = -430.0; angle = 90; type = 1;
    skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true;
    single = true; coop = true; dm = true;
}

// One-shot department cleanup runs after the shared fresh-map objective reset, then destroys itself.
thing { x = 0.0; y = -405.0; angle = 90; type = 17153; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// Basic shift kit is visible from spawn, but the queue geometry immediately forces a route choice.
thing { x = -175.0; y = -355.0; angle = 0; type = 2001; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x =  175.0; y = -355.0; angle = 180; type = 2002; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x =    0.0; y = -245.0; angle = 0; type = 17010; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// Two service-desk power repairs make the player traverse the full serpentine queue. Once both are
// restored, the rear Refund Authorization Terminal replaces the old third loose fuse with a real
// twelve-second hold objective. The audit sequence enters from the left rear lane and grants the
// authoritative third CheckoutFuse only after the player survives Corporate's verification queue.
thing { x = -655.0; y = -205.0; angle = 0; type = 17111; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x =  650.0; y =   80.0; angle = 180; type = 17111; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x =    0.0; y =  425.0; angle = 180; type = 17151; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x = -615.0; y =  360.0; angle = 0; type = 17152; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// After the first repair, the right-front side lane offers an optional Take-A-Number reset. Leaving it
// alone allows a separate left-rear complaint queue to add telegraphed Overtime pressure. The two
// anchors sit on opposite outer lanes and never occupy the central service/clock-out path.
thing { x =  690.0; y =  -25.0; angle = 180; type = 17154; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x = -690.0; y =  245.0; angle = 0; type = 17155; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// Initial hazards sell the department fantasy without filling the central lane with unavoidable fire.
thing { x = -570.0; y = -360.0; angle = 0; type = 17001; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x =  590.0; y = -225.0; angle = 180; type = 17004; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x = -590.0; y =  125.0; angle = 315; type = 17002; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x =  565.0; y =  285.0; angle = 225; type = 17005; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// Full power triggers the shared gated Night Manager and a readable recovery cache at opposite flanks.
thing { x = 0.0; y = 385.0; angle = 270; type = 17101; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
thing { x = -555.0; y = 390.0; angle = 0; type = 17128; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// The shift never relies on a static boss. If the supervisor is cleared, this guide makes the long
// serpentine return leg readable while the shared shift director still owns actual map completion.
thing { x = 0.0; y = -365.0; angle = 90; type = 17132; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }

// Overtime pressure enters from queue edges. Two telegraphed shared hazard anchors stay off the
// spawn/clock-out centerline so the department gets dangerous without becoming a progression trap.
thing { x = -690.0; y =  300.0; angle = 315; type = 17100; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; }
