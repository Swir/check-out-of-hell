namespace = "ZDoom";

vertex { x = -780.0; y = -500.0; }
vertex { x =  780.0; y = -500.0; }
vertex { x =  780.0; y =  500.0; }
vertex { x = -780.0; y =  500.0; }

// Customer Service uses a long serpentine queue instead of electronics-style display aisles.
// Every rail is same-sector geometry: it shapes combat and sightlines without fragile door logic.
vertex { x = -600.0; y = -280.0; }
vertex { x =  360.0; y = -280.0; }
vertex { x = -360.0; y = -120.0; }
vertex { x =  600.0; y = -120.0; }
vertex { x = -600.0; y =   40.0; }
vertex { x =  360.0; y =   40.0; }
vertex { x = -360.0; y =  200.0; }
vertex { x =  600.0; y =  200.0; }

// Two short rear counters protect the final breaker and supervisor arena while leaving flanks open.
vertex { x = -470.0; y = 340.0; }
vertex { x = -120.0; y = 340.0; }
vertex { x =  120.0; y = 340.0; }
vertex { x =  470.0; y = 340.0; }

sector
{
    heightfloor = 0;
    heightceiling = 176;
    texturefloor = "CHKFLR";
    textureceiling = "CHKCEIL";
    lightlevel = 142;
}

