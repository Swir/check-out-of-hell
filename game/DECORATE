actor EmergencyMop : Fist replaces Fist
{
    Tag "Emergency Mop"
    Inventory.PickupMessage "Emergency Mop acquired. Health & Safety did not approve this."
    Weapon.SelectionOrder 4000
    Weapon.KickBack 180

    States
    {
    Ready:
        PUNG A 1 A_WeaponReady
        Loop
    Deselect:
        PUNG A 1 A_Lower
        Loop
    Select:
        PUNG A 1 A_Raise
        Loop
    Fire:
        PUNG B 3
        PUNG C 3 A_CustomPunch(28, 1, CPF_USEAMMO, "BulletPuff", 72)
        PUNG D 4
        PUNG C 3
        PUNG B 3 A_ReFire
        Goto Ready
    }
}

actor ReceiptRipper : Shotgun replaces Shotgun
{
    Tag "Receipt Ripper"
    Inventory.PickupMessage "Receipt Ripper: returns are final."
    Weapon.SelectionOrder 2600
    Weapon.AmmoUse 1
    Weapon.AmmoGive 12
    Weapon.AmmoType "Shell"

    States
    {
    Ready:
        SHTG A 1 A_WeaponReady
        Loop
    Deselect:
        SHTG A 1 A_Lower
        Loop
    Select:
        SHTG A 1 A_Raise
        Loop
    Fire:
        SHTG A 3
        SHTG A 0 A_PlaySound("weapons/shotgf", CHAN_WEAPON)
        SHTG B 5 Bright A_FireBullets(7.0, 5.0, 9, 5, "BulletPuff")
        SHTG C 4
        SHTG D 5
        SHTG CB 4
        SHTG A 3 A_ReFire
        Goto Ready
    }
}

actor PriceGunSMG : Chaingun replaces Chaingun
