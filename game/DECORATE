actor NightManager : BaronOfHell 17003
{
    Tag "Night Manager"
    Health 650
    Speed 10
    PainChance 90

    States
    {
    Spawn:
        MNGR A 10 A_Look
        Loop
    See:
        MNGR A 4 A_Chase
        MNGR B 4 A_Chase
        MNGR C 4 A_Chase
        MNGR D 4 A_Chase
        Loop
    Missile:
        // Keep the original 19-tic attack cycle, but move more of it before the memo leaves
        // the manager's hand. The bright/audio warning now lasts 12 tics (~0.34 s) before fire.
        MNGR E 2 A_FaceTarget
        MNGR F 12 Bright A_PlaySound("coh/managerattack", CHAN_WEAPON)
        MNGR F 0 Bright A_CustomMissile("ManagerMemoProjectile", 32, 0, 0)
        MNGR E 5
        Goto See
    Pain:
        MNGR G 4
        MNGR G 4 A_Pain
        Goto See
    Death:
        MNGR H 6 A_PlaySound("coh/managerdown", CHAN_BODY)
        MNGR I 6
        MNGR J 6 A_NoBlocking
        MNGR K -1
        Stop
    Raise:
        MNGR K 5
        MNGR J 5
        MNGR I 5
        MNGR H 5
        Goto See
    }
}

