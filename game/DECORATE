actor EmergencyMop : Fist replaces Fist
{
    Tag "Emergency Mop"
    Inventory.PickupMessage "Emergency Mop acquired. Health & Safety did not approve this."
    Weapon.SelectionOrder 4000
    Weapon.KickBack 180

    States
    {
    Ready:
        CMOP A 1 A_WeaponReady
        Loop
    Deselect:
        CMOP A 1 A_Lower
        Loop
    Select:
        CMOP A 1 A_Raise
        Loop
    Fire:
        CMOP B 2 A_PlaySound("coh/mopswing", CHAN_WEAPON)
        CMOP C 3 A_CustomPunch(30, 1, 0, "BulletPuff", 80)
        CMOP D 4
        CMOP B 3 A_ReFire
        Goto Ready
    }
}

