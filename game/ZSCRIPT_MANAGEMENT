// CHECKOUT OF HELL - Management Floor objective and deep-Overtime pressure.

// The shared shift director already trusts SupervisorClearanceToken as a recovery marker. Giving the
// token on District Director death lets the existing clock-out, Overtime-retirement and save logic stay
// authoritative without forking a second department-completion ledger.
class ManagementDirectorClearHandler : EventHandler
{
    override void WorldThingDied(WorldEvent e)
    {
        if (!e.Thing || e.Thing.GetClassName() != 'DistrictDirector')
        {
            return;
        }

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (p && p.CountInv("SupervisorClearanceToken") == 0)
        {
            p.A_GiveInventory("SupervisorClearanceToken", 1);
        }
    }
}

// The physical boardroom authorization now begins a ten-second approval hold instead of instantly
// granting full power. The sequence uses one authored outer boardroom lane, gives two readable warning
// beats and hands the existing CheckoutFuse progression its final token only after the hold completes.
// Actor fields and the hidden pending token serialize normally, so save/restore resumes the same review.
class ManagementBoardroomReviewSequence : Actor
{
    bool reviewActive;
    bool firstResponseSpawned;
    bool secondWarningSent;
    bool secondResponseSpawned;
    int reviewStartTic;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP;
        +NOSECTOR;
        +NOGRAVITY;
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        reviewActive = false;
        firstResponseSpawned = false;
        secondWarningSent = false;
        secondResponseSpawned = false;
        reviewStartTic = 0;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }
        if (p.CountInv("SupervisorClearanceToken") > 0)
        {
            Destroy();
            return;
        }
        if (p.CountInv("CheckoutFuse") >= 3)
        {
            if (p.CountInv("ManagementBoardroomReviewPending") > 0)
            {
                p.A_TakeInventory("ManagementBoardroomReviewPending", 1);
            }
            Destroy();
            return;
        }
        if (p.CountInv("ManagementBoardroomReviewPending") == 0)
        {
            return;
        }

        if (!reviewActive)
        {
            reviewActive = true;
            reviewStartTic = Level.maptime;
            Actor.Spawn("OvertimeWarningFlash", Pos);
            p.A_StartSound("coh/overtime", CHAN_AUTO);
            return;
        }

        int elapsed = Level.maptime - reviewStartTic;

        if (!firstResponseSpawned && elapsed >= 35 * 4)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("ScannerTurret", Pos);
            firstResponseSpawned = true;
        }

        if (!secondWarningSent && elapsed >= 35 * 7)
        {
            Actor.Spawn("OvertimeWarningFlash", Pos);
            p.A_StartSound("coh/overtime", CHAN_AUTO);
            secondWarningSent = true;
        }

        if (!secondResponseSpawned && elapsed >= 35 * 9)
        {
            Actor.Spawn("TeleportFog", Pos);
            Actor.Spawn("AngrySelfCheckout", Pos);
            secondResponseSpawned = true;
        }

        if (elapsed >= 35 * 10)
        {
            p.A_TakeInventory("ManagementBoardroomReviewPending", 1);
            p.A_GiveInventory("CheckoutFuse", 1);
            p.A_StartSound("coh/fuse", CHAN_ITEM);
            Destroy();
        }
    }
}

// Full executive authorization gets a readable four-second arrival warning. Actor state serializes
// normally, so save/restore resumes the warning instead of creating an instant or duplicate boss.
class ManagementDirectorArrivalSpawner : Actor
{
    bool arrivalArmed;
    int arrivalTic;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP;
        +NOSECTOR;
        +NOGRAVITY;
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        arrivalArmed = false;
        arrivalTic = 0;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }
        if (p.CountInv("SupervisorClearanceToken") > 0)
        {
            Destroy();
            return;
        }
        if (p.CountInv("CheckoutFuse") < 3)
        {
            return;
        }

        if (!arrivalArmed)
        {
            arrivalArmed = true;
            arrivalTic = Level.maptime + 35 * 4;
            Actor.Spawn("OvertimeWarningFlash", Pos);
            p.A_StartSound("coh/regionalphase", CHAN_AUTO);
            return;
        }

        if (Level.maptime < arrivalTic)
        {
            return;
        }

        Actor.Spawn("TeleportFog", Pos);
        Actor director = Actor.Spawn("DistrictDirector", Pos);
        if (director)
        {
            director.A_StartSound("coh/regionalphase", CHAN_BODY);
            Destroy();
        }
    }
}

// Management Floor's department-specific Overtime rule is an Executive Audit rather than another
// random trap. Once both office circuits are online and Overtime reaches stage 2, one outer office lane
// warns for two seconds before a Scanner/Cart response. The permanent central corridor is never closed.
// The fixed boardroom review temporarily owns the encounter beat; audits pause during that ten-second
// objective and leave an eight-second recovery window afterward instead of stacking pressure unfairly.
class ManagementExecutiveAuditSpawner : Actor
{
    bool warningArmed;
    int responseTic;
    int nextAuditTic;
    int nextCheck;

    Default
    {
        +NOBLOCKMAP;
        +NOSECTOR;
        +NOGRAVITY;
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        warningArmed = false;
        responseTic = 0;
        nextAuditTic = 0;
        nextCheck = Level.maptime + 7;
    }

    override void Tick()
    {
        Super.Tick();

        if (Level.maptime < nextCheck)
        {
            return;
        }
        nextCheck = Level.maptime + 7;

        if (!players[0].mo)
        {
            return;
        }

        PlayerPawn p = PlayerPawn(players[0].mo);
        if (!p)
        {
            return;
        }
        if (p.CountInv("SupervisorClearanceToken") > 0)
        {
            Destroy();
            return;
        }
        if (p.CountInv("CheckoutFuse") < 2)
        {
            return;
        }
        if (p.CountInv("ManagementBoardroomReviewPending") > 0)
        {
            warningArmed = false;
            responseTic = 0;
            nextAuditTic = Level.maptime + 35 * 8;
            return;
        }

        int overtimeStage = CheckoutShiftDirector.GetOvertimeStage();
        if (overtimeStage < 2)
        {
            return;
        }

        if (warningArmed)
        {
            if (Level.maptime < responseTic)
            {
                return;
            }

            Actor.Spawn("TeleportFog", Pos);
            if (overtimeStage >= 3)
            {
                Actor.Spawn("CartOfDoom", Pos);
            }
            else
            {
                Actor.Spawn("ScannerTurret", Pos);
            }
            warningArmed = false;

            int delaySeconds = 32;
            if (overtimeStage >= 3)
            {
                delaySeconds = 22;
            }
            nextAuditTic = Level.maptime + 35 * delaySeconds;
            return;
        }

        if (nextAuditTic == 0)
        {
            nextAuditTic = Level.maptime + 35 * 16;
            return;
        }
        if (Level.maptime < nextAuditTic)
        {
            return;
        }

        Actor.Spawn("OvertimeWarningFlash", Pos);
        p.A_StartSound("coh/overtime", CHAN_AUTO);
        warningArmed = true;
        responseTic = Level.maptime + 35 * 2;
    }
}
