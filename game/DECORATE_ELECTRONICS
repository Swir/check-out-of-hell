// CHECKOUT OF HELL - Electronics department-local controls and display hazards.
// Visible art is generated deterministically by tools/generate_presentation_assets.py.

// Invisible department marker used only to keep the shared HUD honest in MAP04. The map-local
// initializer grants it after the fresh-world cleanup pass; normal save/restore preserves it.
actor ElectronicsDepartmentToken : Inventory
{
    Tag "Electronics Department Marker"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        TNT1 A -1
        Stop
    }
}

// Hidden hand-off token for the timed Store Network Reboot sequence. The map-local sequence actor
// owns the actual final CheckoutFuse grant so the pickup cannot instantly skip the authored defence.
actor ElectronicsRebootPending : Inventory
{
    Tag "Store Network Reboot Pending"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        TNT1 A -1
        Stop
    }
}

actor ElectronicsNetworkReboot : CustomInventory
{
    Tag "Store Network Reboot"
    Inventory.PickupMessage "Store network reboot accepted. Hold the department while the network cycles."
    Inventory.PickupSound "coh/fuse"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        ENRB A -1 Bright
        Stop
    Pickup:
        TNT1 A 0 A_GiveInventory("ElectronicsRebootPending", 1)
        Stop
    }
}

// Optional full-power safety task. Taking this control suppresses only future Electronics demo-wall
// surges; hostile Overtime reinforcements and management remain active.
actor ElectronicsDisplayKillSwitch : Inventory
{
    Tag "Demo Wall Kill Switch"
    Inventory.PickupMessage "Demo wall isolated. Management still expects those screens upsold."
    Inventory.PickupSound "coh/fuse"
    Inventory.MaxAmount 1

    States
    {
    Spawn:
        EKIL A -1 Bright
        Stop
    }
}

// Short-lived project-owned display-bank fault. The spawner always emits a normal Overtime warning
// two seconds before this actor appears, keeping the side-lane hazard readable rather than random.
actor ElectronicsDisplayBurst
{
    Radius 10
    Height 22
    +NOBLOCKMAP
    +NOGRAVITY
    +NOCLIP

    States
    {
    Spawn:
        ESUR A 7 Bright A_PlaySound("coh/overtimearc", CHAN_BODY)
        ESUR B 6 Bright
        ESUR C 0 Bright A_Explode(9, 88)
        ESUR C 6 Bright
        ESUR B 5
        Stop
    }
}

// Overtime can temporarily close one authored Electronics aisle without blocking the central
// service/clock-out lane. Reuse the project-owned staff-shutter art and interaction cue; the actor
// is intentionally indestructible but self-retires after five seconds, so the lock is pressure, not
// a progression trap.
actor ElectronicsLockdownShutter
{
    Tag "Overtime Security Shutter"
    Radius 116
    Height 72
    Scale 2.0
    +SOLID
    +NOGRAVITY

    States
    {
    Spawn:
        COSH A 1 Bright A_PlaySound("coh/shutter", CHAN_BODY)
        COSH A 175 Bright
        COSH A 1 Bright A_PlaySound("coh/shutter", CHAN_BODY)
        Stop
    }
}
